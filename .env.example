# LINE Developers Console > your Messaging API channel
# "Basic settings" tab > Channel secret
LINE_CHANNEL_SECRET=
# "Messaging API" tab > Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=

# Redis (Upstash). Set ONE of the two pairs below.

# Injected automatically by the Vercel Upstash integration:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Or, for a database created directly on upstash.com:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
